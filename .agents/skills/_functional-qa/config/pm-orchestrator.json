{
  "schema_version": "1",
  "include_label": "pm:agent-ready",
  "skip_labels": [
    "pm:portability-gap",
    "self-heal:exhausted",
    "do-not-merge",
    "blocked-on-human"
  ],
  "max_dispatches_per_run": 3,
  "provider_concurrency_caps": {
    "codex": 3,
    "claude": 3
