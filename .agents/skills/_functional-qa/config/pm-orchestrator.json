  "priority_label_weights": {
    "priority:p0": 100,
    "priority:p1": 50,
    "priority:p2": 10
  },
  "severity_body_weight": 10,
  "age_weight_per_day": 1,
  "notes": "PM orchestrator config. Edit weights/caps to retune scheduling without changing code."
}
