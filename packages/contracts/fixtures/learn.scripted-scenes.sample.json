        { "id": "player", "displayName": "You", "avatarEmoji": "🙂" }
      ],
      "rows": [
        {
          "rowId": "seoul-1",
          "speakerId": "tong",
          "atMs": 0,
          "typingMs": 500,
          "primaryText": "해은이가 떡볶이 먹으러 가자고 했어!",
          "localExplanationText": "해은 + -이(주어), 떡볶이(음식), -자고 했어(제안 전달)",
          "englishText": "Haeun asked if we should go eat tteokbokki!"
        },
        {
          "rowId": "seoul-2",
          "speakerId": "character",
          "atMs": 2200,
          "typingMs": 600,
          "primaryText": "나 지금 푸드스트리트 앞이야. 너는?",
          "localExplanationText": "나(저), 지금(현재), 앞(앞쪽), 너는?(주제 전환 질문)",
          "englishText": "I'm in front of Food Street now. What about you?"
        },
        {
          "rowId": "seoul-3",
          "speakerId": "player",
          "atMs": 4200,
          "primaryText": "나도 거의 도착했어!",
          "englishText": "I'm almost there too!"
        }
      ]
    },
    {
      "sceneId": "tokyo-cafe-time-check",
      "cityId": "tokyo",
      "objectiveId": "ja-cafe-meetup-time",
      "title": "LINE-style cafe meetup check",
      "hookText": "Tong rehearses a quick meetup exchange.",
      "speakers": [
        { "id": "tong", "displayName": "Tong", "avatarEmoji": "🐾" },
        { "id": "character", "displayName": "Aoi", "avatarEmoji": "🍵" },
