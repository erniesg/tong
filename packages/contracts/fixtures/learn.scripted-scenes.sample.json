        {
          "rowId": "tokyo-2",
          "speakerId": "character",
          "atMs": 2100,
          "typingMs": 600,
          "primaryText": "カフェに六時半に着きます。先に席を取っておくね。",
          "localExplanationText": "六時半(6:30), 着きます(도착하다), 先に(먼저), 席を取る(자리 맡다)",
          "englishText": "I'll arrive at the cafe at 6:30. I'll grab a seat first."
        },
        {
          "rowId": "tokyo-3",
          "speakerId": "player",
          "atMs": 4300,
          "primaryText": "ありがとう、すぐ向かう！",
          "englishText": "Thanks, heading there now!"
        }
      ]
    },
    {
