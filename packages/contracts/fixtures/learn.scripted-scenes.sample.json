      "rows": [
        {
          "rowId": "tokyo-1",
          "speakerId": "tong",
          "atMs": 0,
          "typingMs": 500,
          "primaryText": "青井さんからメッセージだよ。",
          "localExplanationText": "青井さん(이름+존칭), から(~에서), メッセージ(메시지), だよ(설명)",
          "englishText": "You got a message from Aoi."
