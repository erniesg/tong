TONG_BACKEND_MODE=local-mock
TONG_LOCAL_API_BASE_URL=http://localhost:8787
TONG_REMOTE_API_BASE_URL=https://tong-api.erniesg.workers.dev
TONG_DEMO_PASSWORD=TONG-DEMO-ACCESS
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
TONG_YOUTUBE_API_KEY=your_youtube_api_key_optional
TONG_SPOTIFY_CLIENT_ID=your_spotify_client_id
TONG_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
OAUTH_CLIENT_ID=your_google_oauth_client_id
OPENAI_API_KEY=your_openai_api_key
OAUTH_CLIENT_SECRET=your_oauth_client_secret
NEXT_PUBLIC_TONG_API_BASE=https://tong-api.erniesg.workers.dev
NEXT_PUBLIC_TONG_PUBLIC_DOMAIN=tong.berlayar.ai
NEXT_PUBLIC_TONG_ASSETS_BASE_URL=https://assets.tong.berlayar.ai
NEXT_PUBLIC_TONG_EXTENSION_ZIP_URL=https://github.com/erniesg/tong/archive/refs/heads/master.zip
NEXT_PUBLIC_TONG_YOUTUBE_DEMO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ
NEXT_PUBLIC_TONG_DEMO_PASSWORD_HINT=Ask demo host for access password.
TONG_ASSETS_R2_BUCKET=tong-assets
TONG_RUNTIME_ASSET_MANIFEST_KEY=runtime-assets/manifest.json
TONG_RUNS_R2_BUCKET=tong-runs
TONG_RUNS_PUBLIC_BASE_URL=https://runs.tong.berlayar.ai

# Volcengine / ByteDance APIs
VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_TTS_APP_ID=your_volcengine_tts_app_id
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_tts_access_token
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_BASE_URL=https://openspeech.bytedance.com/api/v1/tts

# ElevenLabs APIs (SFX, Music, TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Replicate API (Nano Banana 2 image gen, Veo 3.1 Fast video gen, Lyria 2 music gen)
REPLICATE_API_TOKEN=your_replicate_api_token
REPLICATE_WEBHOOK_BASE_URL=https://your-public-url.ngrok.io

# Tencent Cloud Hunyuan 3D (image/text to 3D model generation)
# Option A: OpenAI-compatible endpoint (Pro only, simpler setup)
TENCENT_HUNYUAN3D_API_KEY=your_tencent_hunyuan3d_api_key
# Option B: TC3 signed API (all endpoints — Pro, Rapid, Texture, Topology, UV, Parts, Profile, Convert)
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_AI3D_REGION=ap-guangzhou

# Google Gemini (video understanding, structured analysis)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key

# Signals intelligence (TikTok / Instagram / Xiaohongshu)
# All optional — module falls back to public web scraping without API keys.
# Set SIGNALS_MOCK=true for development to skip network calls entirely.
TIKTOK_API_KEY=your_tiktok_api_key
INSTAGRAM_API_KEY=your_instagram_graph_api_access_token
XHS_API_KEY=your_xhs_partner_api_key
SIGNALS_MOCK=false
SIGNALS_CACHE_TTL_MS=900000

# Signal scheduler (autonomous daily keyword gen + scrape)
SIGNAL_SCHEDULER_ENABLED=false
SIGNAL_SCHEDULER_INTERVAL_MS=86400000
